{
  "manifest_version": 3,
  "name": "Mirror Pool Scout",
  "version": "1.2.0",
  "description": "Live MTG market procurement, visual decklist parsing, and financial tracking.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "scripting"
  ],
  "action": {
    "default_title": "Mirror Pool Scout",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "host_permissions": [
    "*://*.ebay.com/*",
    "*://*.tcgplayer.com/*",
    "*://*.fanaticscollect.com/*",
    "*://*.goldin.co/*",
    "*://*.cardmarket.com/*",
    "*://*.mtgdecks.net/*",
    "*://*.mtggoldfish.com/*",
    "*://*.magic.gg/*",
    "*://*.wizards.com/*",
    "https://api.scryfall.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ebay.com/itm/*",
        "*://*.tcgplayer.com/product/*",
        "*://*.fanaticscollect.com/*",
        "*://*.goldin.co/*",
        "*://*.cardmarket.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "short_name": "Scout",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}